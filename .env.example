# Copie para .env.local e preencha. Variáveis VITE_* são expostas ao navegador:
# nunca coloque segredos de servidor aqui (use variáveis sem prefixo em funções da Vercel).

# Fonte de dados: "mock" (localStorage, padrão) ou "api" (backend real)
VITE_DATA_SOURCE=mock

# URL base da API quando VITE_DATA_SOURCE=api (ex.: https://api.seudominio.com)
VITE_API_BASE_URL=

# Google Maps Embed API — chave restrita por domínio (HTTP referrer) no Google Cloud
VITE_GOOGLE_MAPS_API_KEY=

# Supabase (opcional, caso seja o backend escolhido) — apenas a chave pública "anon"
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Notificações push (Web Push) — chave pública VAPID
VITE_VAPID_PUBLIC_KEY=
